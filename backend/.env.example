# Required
DATABASE_URL=postgresql+psycopg://paperpulse:paperpulse@postgres:5432/paperpulse
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret

# Database timeout safeguards (optional)
DB_CONNECT_TIMEOUT_SECS=10
DB_POOL_TIMEOUT_SECS=10
DB_STATEMENT_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=10000

# LLM summary (OpenAI-compatible)
LLM_BASE_URL=https://your-openai-compatible-endpoint
LM_API_KEY=your-llm-api-key

# Elsevier fetcher
Elsevier_KEY=your-elsevier-api-key

# Optional identifier for plain HTTP/RSS requests. Browser requests always use
# Patchright's native User-Agent to keep Chromium client hints consistent.
FETCHER_USER_AGENT=

# EasyScholar journal-rank export. Obtain this SecretKey from the EasyScholar
# "开放接口" page after signing in; do not commit a real key.
EASYSCHOLAR_SECRET_KEY=

# Optional: Email verification
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_KEY=your-smtp-password
SOURCE_EMAIL=donotreply@example.com

# Optional: CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 抓取执行器和浏览器池（可选）
ARTICLE_FETCH_EXECUTOR_WORKERS=8
ARTICLE_FETCH_EXECUTOR_TIMEOUT_SECS=1800
IMAGE_CACHE_EXECUTOR_WORKERS=2
# 图片批次预算：到时停止领取新任务，等待正在下载的线程安全收尾
IMAGE_CACHE_EXECUTOR_TIMEOUT_SECS=600
BROWSER_POOL_SIZE=2
BROWSER_MAX_PAGES=4
# Optional Patchright browser channel, for example msedge on a host where
# Microsoft Edge is installed. Leave empty to use Patchright Chromium.
BROWSER_CHANNEL=
# Docker runs headful Chromium inside Xvfb. Set to 1 only when no display or
# virtual display is available.
BROWSER_HEADLESS=0
# RSC uses a silent SSO redirect before rendering the article body.
RSC_POST_NAVIGATION_WAIT_MS=7000
